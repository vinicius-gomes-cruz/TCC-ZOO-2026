@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
title Diagrama de Componentes - Persistencia e Banco de Dados (C3)

LAYOUT_LEFT_RIGHT()

Container_Boundary(API_Repositories, "Camada de Acesso a Dados - Spring Data JPA") {
    Component(AnimalRepository, "AnimalRepository", "Acesso a dados", "Spring Data JPA")
    Component(HabitatRepository, "HabitatRepository", "Acesso a dados", "Spring Data JPA")
    Component(UsuarioRepository, "UsuarioRepository", "Acesso a dados", "Spring Data JPA")
    Component(CaixaRepository, "CaixaRepository", "Acesso a dados", "Spring Data JPA")
    Component(EstoqueItemRepository, "EstoqueItemRepository", "Acesso a dados", "Spring Data JPA")
    Component(EstoqueAnotacaoRepository, "EstoqueAnotacaoRepository", "Anotações de estoque", "Spring Data JPA")
    Component(BioterioEstoqueRepository, "BioterioEstoqueRepository", "Estoques por biotério", "Spring Data JPA")
    Component(AlimentacaoRepository, "AlimentacaoRepository", "Registros de alimentação", "Spring Data JPA")
    Component(RefreshTokenRepository, "RefreshTokenRepository", "Persistência de refresh tokens", "Spring Data JPA")
}

ContainerDb(DB, "Banco de Dados", "MySQL", "Tabelas: animal, habitat, usuario,\nhabitat_requerimentos, habitat_enriquecimentos")

Rel(AnimalRepository, DB, "Lê e escreve")
Rel(HabitatRepository, DB, "Lê e escreve")
Rel(UsuarioRepository, DB, "Lê e escreve")
Rel(CaixaRepository, DB, "Lê e escreve")
Rel(EstoqueItemRepository, DB, "Lê e escreve")
Rel(EstoqueAnotacaoRepository, DB, "Lê e escreve")
Rel(BioterioEstoqueRepository, DB, "Lê e escreve")
Rel(AlimentacaoRepository, DB, "Lê e escreve")
Rel(RefreshTokenRepository, DB, "Lê e escreve")

@enduml
