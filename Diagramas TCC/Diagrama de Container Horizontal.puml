@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
title Sistema de Gerenciamento de Zoológico – Diagrama de Containers (C2)

LAYOUT_LEFT_RIGHT()

' Pessoas (atores)
Person(Funcionario, "Funcionário", "Gerencia animais e habitats do zoológico")
Person(Administrador, "Administrador", "Gerencia usuários e acessa configurações do sistema")

' Sistema e containers
System_Boundary(Sistema, "Sistema de Gerenciamento do Zoológico") {
    Container(WebApp, "Aplicação Web", "React + TypeScript (Vite)", "Interface web acessada via navegador;\ngerencia habitats e animais;\nresponsiva para desktop e mobile")
    Container(API, "API Backend", "Spring Boot + Spring Data JPA", "Expõe endpoints REST para animais,\nhabitats e usuários;\nconfigura CORS via WebConfig")
    Container(Analytics, "Serviço de Análise de Estoque", "Python + pandas", "Processa dados de estoque;\ngera métricas e previsões para apoio à decisão")
    ContainerDb(DB, "Banco de Dados", "MySQL", "Armazena animais, habitats e usuários;\ntabelas de relacionamento para\nrequerimentos e enriquecimento ambiental")
}

' Relacionamentos
Rel(Funcionario, WebApp, "Acessa via navegador (HTTPS)")
Rel(Administrador, WebApp, "Acessa via navegador (HTTPS)")
Rel(WebApp, API, "Chamadas HTTP/JSON REST")
Rel(API, DB, "Lê e escreve via JPA/Hibernate")
Rel(Analytics, DB, "Lê dados operacionais e grava métricas/previsões")
Rel(API, Analytics, "Dispara/consulta processamento analítico")

@enduml
