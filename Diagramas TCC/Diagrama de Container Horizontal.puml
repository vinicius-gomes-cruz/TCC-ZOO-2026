@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
title Sistema de Gerenciamento de Zoológico – Diagrama de Containers (C2)

LAYOUT_LEFT_RIGHT()

' Pessoas (atores)
Person(Funcionario, "Funcionário", "Gerencia animais e habitats do zoológico")
Person(Administrador, "Administrador", "Gerencia usuários e acessa configurações do sistema")

' Sistema e containers
System_Boundary(Sistema, "Sistema de Gerenciamento do Zoológico") {
    Container(WebApp, "Aplicação Web (cliente)", "React + TypeScript (Vite)", "SPA compilada; consome a API via VITE_API_URL ou rota /api no desenvolvimento")
    Container(API, "API Backend", "Spring Boot + Spring Data JPA", "Expõe endpoints REST para animais, habitats, estoque, bioterio e usuários; autenticação JWT; configuração via WebConfig")
    ContainerDb(DB, "Banco de Dados", "MySQL", "Armazena animais, habitats, usuários, estoque, bioterio, caixas e tokens de refresh")
}

' Relacionamentos
Rel(Funcionario, WebApp, "Acessa via navegador (HTTPS)")
Rel(Administrador, WebApp, "Acessa via navegador (HTTPS)")
Rel(WebApp, API, "Chamadas HTTP/JSON REST")
Rel(API, DB, "Lê e escreve via JPA/Hibernate")

' Observação: todos os containers normalmente empacotados em Docker


@enduml
