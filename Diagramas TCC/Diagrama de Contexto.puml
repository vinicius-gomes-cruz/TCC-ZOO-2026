@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
title Sistema de Gerenciamento de Zoológico - Diagrama de Contexto (C1)

' Atores / Pessoas
Person(Funcionario, "Funcionário", "Gerencia operações do zoológico")
Person(Administrador, "Administrador", "Administração do sistema")

' Sistema principal
System(Sistema, "Sistema de Gerenciamento do Zoológico", "Gerencia animais, habitats e usuários do zoológico;\nacessado via navegador web")

' Relacionamentos
Rel(Funcionario, Sistema, "Cadastra e consulta animais e habitats")
Rel(Administrador, Sistema, "Gerencia usuários e configurações do sistema")

@enduml